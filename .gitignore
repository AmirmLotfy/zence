# --- Secrets (never commit) --------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
.zence/local.yaml

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# --- Node / Next -------------------------------------------------------------
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
.vercel/
playwright-report/
test-results/

# --- Zence runtime state -----------------------------------------------------
# Local audit DB lives in ~/.zence, but guard against a stray copy in-tree.
zence.db
zence.db-*
*.sqlite3

# --- OS / editor -------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
!.vscode/extensions.json
.vercel

# Scratch output of `brand/verify.py`, regenerated on every run.
brand/.verify-diff.png

# The artwork drop folder. The same two files are committed at brand/source/,
# which is what build.py measures and verify.py diffs against — a second copy
# would be a second thing to keep in sync.
zence-logo/

# Video build outputs. The scripts are committed; the frames, clips and the
# rendered mp4 are large and reproducible from them.
video/build/s_*/
video/build/*.mp4
video/build/*.png
video/build/*.html
video/build/_*
video/build/concat.txt
video/src/
video/*.mp4
