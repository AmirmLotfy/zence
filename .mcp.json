{
  "mcpServers": {
    "datahub": {
      "command": "uvx",
      "args": ["mcp-server-datahub@0.6.0"],
      "env": {
        "DATAHUB_GMS_URL": "${user_config.datahub_url}",
        "DATAHUB_GMS_TOKEN": "${user_config.datahub_token}",
        "TOOLS_IS_MUTATION_ENABLED": "true",
        "TOOLS_IS_USER_ENABLED": "true"
      }
    }
  }
}
