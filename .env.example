# Zence — example environment. Copy to `.env` and fill in.
#   cp .env.example .env
#
# `.env` is gitignored. Never commit real tokens.
#
# When Zence runs as a Claude Code plugin you do NOT need this file: the plugin
# prompts for these values at enable time via `userConfig` and stores the token
# in the macOS Keychain. This file is for CLI and test use.

# --- DataHub connection ------------------------------------------------------

# GMS endpoint. With the recommended SSH tunnel this is a localhost address:
#   gcloud compute ssh zence-datahub --zone=<zone> --tunnel-through-iap -- \
#     -L 8080:localhost:8080 -L 9002:localhost:9002
DATAHUB_GMS_URL=http://localhost:8080

# Personal Access Token, created in the DataHub UI under Settings → Access Tokens.
DATAHUB_GMS_TOKEN=

# --- DataHub MCP server ------------------------------------------------------
# Zence intercepts this server's tool calls. Mutation tools are required for the
# write-back demo; the user tool is used for audit attribution.
TOOLS_IS_MUTATION_ENABLED=true
TOOLS_IS_USER_ENABLED=true

# --- Zence runtime -----------------------------------------------------------

# audit | enforce | demo
ZENCE_MODE=enforce

# Override the interpreter used by the plugin hook shim (optional).
# ZENCE_PYTHON=

# Local audit database. Defaults to ~/.zence/zence.db
# ZENCE_DB_PATH=
